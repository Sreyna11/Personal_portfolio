<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio - Aok Sreyna</title>
    <link rel="stylesheet" href="styles.css">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
     <!-- Remix Icons -->
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css"
      rel="stylesheet"
    />


    <!-- Custom Configuration -->
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              pink: {
                50: "#fdf2f8",
                100: "#fce7f3",
                200: "#fbcfe8",
                300: "#f9a8d4",
                400: "#f472b6",
                500: "#ec4899",
                600: "#db2777",
                700: "#be185d",
                800: "#9d174d",
                900: "#831843",
              },
            },
            animation: {
              "fade-in": "fadeIn 0.8s ease-out",
              "slide-up": "slideUp 0.6s ease-out",
              float: "float 6s ease-in-out infinite",
            },
            keyframes: {
              fadeIn: {
                "0%": { opacity: "0" },
                "100%": { opacity: "1" },
              },
              slideUp: {
                "0%": { opacity: "0", transform: "translateY(30px)" },
                "100%": { opacity: "1", transform: "translateY(0)" },
              },
              float: {
                "0%, 100%": { transform: "translateY(0px)" },
                "50%": { transform: "translateY(-10px)" },
              },
            },
          },
        },
      };
    </script>

   
    
  </head>
  <body class="text-gray-800">
    <!-- Navigation -->
    <nav class="fixed w-full z-50 bg-white/95 backdrop-blur-sm shadow-sm">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex justify-between items-center h-20">
          <!-- Logo -->
          <a
            href="#home"
            class="text-2xl font-bold text-gray-800 animate-fade-in"
          >
            <span class="gradient-text-pink">Portfolio.</span>
          </a>

          <!-- Desktop Menu -->
          <div class="hidden md:flex space-x-8">
            <a
              href="#home"
              class="nav-link font-medium text-gray-700 hover:text-pink-600 transition"
              >Home</a
            >
            <a
              href="#about"
              class="nav-link font-medium text-gray-700 hover:text-pink-600 transition"
              >About</a
            >
            <a
              href="#education"
              class="nav-link font-medium text-gray-700 hover:text-pink-600 transition"
              >Education</a
            >
            <a
              href="#skills"
              class="nav-link font-medium text-gray-700 hover:text-pink-600 transition"
              >Skills</a
            >
            <a
              href="#projects"
              class="nav-link font-medium text-gray-700 hover:text-pink-600 transition"
              >Projects</a
            >
            <a
              href="#contact"
              class="nav-link font-medium text-gray-700 hover:text-pink-600 transition"
              >Contact</a
            >
          </div>

          <!-- Mobile Menu Button with Toggle Icon -->
          <button id="menu-btn" class="md:hidden text-pink-600 text-2xl">
            <i class="ri-menu-line"></i>
          </button>
        </div>

        <!-- Mobile Dropdown Menu -->
        <div
          id="mobile-menu"
          class="md:hidden hidden bg-white shadow-lg rounded-lg mt-2"
        >
          <div class="flex flex-col py-3">
            <a
              href="#home"
              class="px-6 py-3 text-gray-700 hover:text-pink-600 hover:bg-pink-50 font-medium"
              >Home</a
            >
            <a
              href="#about"
              class="px-6 py-3 text-gray-700 hover:text-pink-600 hover:bg-pink-50 font-medium"
              >About</a
            >
            <a
              href="#education"
              class="px-6 py-3 text-gray-700 hover:text-pink-600 hover:bg-pink-50 font-medium"
              >Education</a
            >
            <a
              href="#skills"
              class="px-6 py-3 text-gray-700 hover:text-pink-600 hover:bg-pink-50 font-medium"
              >Skills</a
            >
            <a
              href="#projects"
              class="px-6 py-3 text-gray-700 hover:text-pink-600 hover:bg-pink-50 font-medium"
              >Projects</a
            >
            <a
              href="#contact"
              class="px-6 py-3 text-gray-700 hover:text-pink-600 hover:bg-pink-50 font-medium"
              >Contact</a
            >
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="pt-32 pb-24 min-h-[85vh] flex items-center">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex flex-col lg:flex-row items-center gap-12">
          <!-- Left Content -->
          <div class="lg:w-1/2 animate-slide-up">
            <p class="text-pink-600 font-medium mb-3 text-lg">
              <i class="ri-sparkling-2-fill mr-2"></i> HELLO, I'M
            </p>
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
              Aok Sreyna
            </h1>
            <h2 class="text-2xl md:text-3xl mb-6">
              <span class="gradient-text-pink font-bold"
                >Web Developer</span
              >
            </h2>
            <p class="text-gray-600 mb-10 leading-relaxed text-lg">
              I build robust web applications using modern technologies.
              Passionate about creating scalable back-end architectures and
              user-friendly interfaces.
            </p>
            <div class="flex gap-4">
              <a
                href="#contact"
                class="btn-pink font-medium py-4 px-8 rounded-xl"
              >
                Hire Me <i class="ri-arrow-right-line ml-2"></i>
              </a>
              <a
                href="#projects"
                class="btn-outline-pink font-medium py-4 px-8 rounded-xl"
              >
                View Projects
              </a>
            </div>
          </div>

          <!-- Right Image -->
          <div class="lg:w-1/2 flex justify-center">
            <div class="relative">
              <div
                class="w-80 h-80 md:w-96 md:h-96 rounded-full border-8 border-white shadow-2xl overflow-hidden animate-float"
              >
                <img
                  src="home.png"
                  alt="Aok Sreyna"
                  class="w-full h-full object-cover"
                />
              </div>
              <div
                class="absolute -bottom-4 left-1/2 transform -translate-x-1/2 bg-white px-6 py-3 rounded-full shadow-lg border border-pink-100"
              >
                <span
                  class="text-sm font-semibold gradient-text-pink flex items-center"
                >
                  <i class="ri-code-s-slash-line mr-2"></i> Web Developer
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold text-center text-gray-800 mb-4">
          About Me
        </h2>
        <p class="text-center text-gray-600 mb-2">Get to know me better</p>
        <div class="section-title"></div>

        <div class="flex flex-col lg:flex-row items-center gap-16">
          <!-- Image -->
          <div class="lg:w-2/5">
            <img
              src="home.png"
              alt="Aok Sreyna"
              class="rounded-2xl shadow-xl w-full"
            />
          </div>

          <!-- Content -->
          <div class="lg:w-3/5">
            <h3 class="text-3xl font-bold text-gray-800 mb-6">
              Hello! I'm Aok Sreyna
            </h3>
            <p class="text-gray-600 mb-8 leading-relaxed text-lg">
              I'm a passionate 20-year-old web developer from Cambodia,
              currently studying Computer Science. I love creating beautiful,
              functional websites that provide excellent user experiences. My
              journey in web development started with simple HTML pages and has
              evolved into building complex, full-stack web applications.
            </p>

            <div class="grid grid-cols-2 gap-6 mb-10">
              <div class="bg-pink-50 p-5 rounded-xl border border-pink-100">
                <p class="font-semibold text-pink-600 flex items-center">
                  <i class="ri-user-line mr-2"></i> Name
                </p>
                <p class="text-gray-700 text-lg">Aok Sreyna</p>
              </div>
              <div class="bg-pink-50 p-5 rounded-xl border border-pink-100">
                <p class="font-semibold text-pink-600 flex items-center">
                  <i class="ri-calendar-line mr-2"></i> Age
                </p>
                <p class="text-gray-700 text-lg">20 Years</p>
              </div>
              <div class="bg-pink-50 p-5 rounded-xl border border-pink-100">
                <p class="font-semibold text-pink-600 flex items-center">
                  <i class="ri-map-pin-line mr-2"></i> Location
                </p>
                <p class="text-gray-700 text-lg">Phnom Penh, Cambodia</p>
              </div>
              <div class="bg-pink-50 p-5 rounded-xl border border-pink-100">
                <p class="font-semibold text-pink-600 flex items-center">
                  <i class="ri-graduation-cap-line mr-2"></i> Education
                </p>
                <p class="text-gray-700 text-lg">Computer Science Student</p>
              </div>
            </div>

            <div
              class="bg-gradient-to-r from-pink-50 to-pink-100 p-7 rounded-2xl border border-pink-200"
            >
              <p class="text-pink-800 text-lg italic">
                <i class="ri-double-quotes-l text-2xl text-pink-600 mr-2"></i>
                I believe that great design combined with clean, efficient code
                creates digital experiences that truly matter.
                <i class="ri-double-quotes-r text-2xl text-pink-600 ml-2"></i>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Education Section -->
    <section
      id="education"
      class="py-20 bg-gradient-to-r from-pink-50 to-white"
    >
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold text-center text-gray-800 mb-4">
          My Education
        </h2>
        <p class="text-center text-gray-600 mb-2">My academic journey</p>
        <div class="section-title"></div>

        <div class="card rounded-2xl p-8 md:p-12">
          <div class="max-w-4xl mx-auto">
            <!-- Timeline -->
            <div class="timeline">
              <!-- High School -->
              <div class="timeline-item">
                <div
                  class="flex flex-col md:flex-row md:justify-between md:items-start mb-4"
                >
                  <h3 class="text-2xl font-bold text-gray-800">
                    High School Diploma
                  </h3>
                  <span
                    class="text-pink-600 font-bold bg-pink-50 px-4 py-2 rounded-full text-base mt-2 md:mt-0"
                    >2020 - 2023</span
                  >
                </div>
                <div class="mb-6">
                  <p class="text-gray-700 text-lg font-medium">
                    General High School Education
                  </p>
                  <p class="text-gray-600 mt-2">
                    Completed comprehensive high school education with a strong
                    focus on science, mathematics, and technology subjects that
                    laid the foundation for my technical career.
                  </p>
                </div>
                <div class="bg-pink-50 p-6 rounded-xl border border-pink-100">
                  <h4
                    class="font-bold text-pink-600 mb-3 text-lg flex items-center"
                  >
                    <i class="ri-medal-line mr-2"></i> Key Achievements:
                  </h4>
                  <ul class="text-gray-700 space-y-2">
                    <li class="flex items-start">
                      <i
                        class="ri-checkbox-circle-fill text-pink-500 mr-2 mt-1"
                      ></i>
                      Graduated with honors in science stream
                    </li>
                    <li class="flex items-start">
                      <i
                        class="ri-checkbox-circle-fill text-pink-500 mr-2 mt-1"
                      ></i>
                      Participated in regional science and technology
                      competitions
                    </li>
                    <li class="flex items-start">
                      <i
                        class="ri-checkbox-circle-fill text-pink-500 mr-2 mt-1"
                      ></i>
                      Developed strong foundation in mathematics and physics
                    </li>
                    <li class="flex items-start">
                      <i
                        class="ri-checkbox-circle-fill text-pink-500 mr-2 mt-1"
                      ></i>
                      Learned basic computer skills
                    </li>
                  </ul>
                </div>
              </div>

              <!-- University -->
              <div class="timeline-item">
                <div
                  class="flex flex-col md:flex-row md:justify-between md:items-start mb-4"
                >
                  <h3 class="text-2xl font-bold text-gray-800">
                    Bachelor of Computer Science
                  </h3>
                  <span
                    class="text-pink-600 font-bold bg-pink-50 px-4 py-2 rounded-full text-base mt-2 md:mt-0"
                    >2023 - Present</span
                  >
                </div>
                <div class="mb-6">
                  <p class="text-gray-700 text-lg font-medium">
                    Royal University of Phnom Penh
                  </p>
                  <p class="text-gray-600 mt-2">
                    Currently pursuing a degree in Computer Science with
                    specialization in software development, web technologies,
                    and human-computer interaction. Actively involved in coding
                    projects and web development.
                  </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div class="bg-pink-50 p-6 rounded-xl border border-pink-100">
                    <h4
                      class="font-bold text-pink-600 mb-3 text-lg flex items-center"
                    >
                      <i class="ri-book-open-line mr-2"></i> Core Courses:
                    </h4>
                    <ul class="text-gray-700 space-y-2">
                      <li>Programming Fundamentals & Algorithms</li>
                      <li>Data Structures & Database Management</li>
                      <li>Web Development</li>
                      <li>Computer Networks & Security</li>
                    </ul>
                  </div>
                  <div class="bg-pink-50 p-6 rounded-xl border border-pink-100">
                    <h4
                      class="font-bold text-pink-600 mb-3 text-lg flex items-center"
                    >
                      <i class="ri-focus-3-line mr-2"></i> Current Focus:
                    </h4>
                    <ul class="text-gray-700 space-y-2">
                      <li>Full-Stack Web Development</li>
                      <li>React.js & Next.js Ecosystem</li>
                      <li>PHP & Laravel Architecture</li>
                      <li>Database Management (SQL/PostgreSQL)</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold text-center text-gray-800 mb-4">
          My Skills
        </h2>
        <p class="text-center text-gray-600 mb-2">Technologies I work with</p>
        <div class="section-title"></div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Frontend & UI Category -->
          <div class="bg-pink-50/50 rounded-3xl p-8 border border-pink-100 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-2xl font-bold text-gray-800 mb-8 flex items-center">
              <i class="ri-layout-3-fill text-pink-500 mr-3"></i> Frontend & UI
            </h3>
            <div class="space-y-6">
              <!-- React.js -->
              <div class="group">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-3">
                     <div class="w-10 h-10 rounded-lg bg-white shadow-sm flex items-center justify-center text-xl text-pink-500 group-hover:scale-110 transition-transform">
                       <i class="ri-reactjs-fill"></i>
                     </div>
                     <span class="font-semibold text-gray-700">React.js</span>
                  </div>
                  <span class="font-bold text-pink-600">70%</span>
                </div>
                <div class="w-full bg-pink-100 rounded-full h-2.5 overflow-hidden">
                  <div class="progress-bar" style="--target-width: 70%; width: 0%; background: linear-gradient(90deg, #ec4899, #f472b6);"></div>
                </div>
              </div>
              
              <!-- Next.js -->
              <div class="group">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-3">
                     <div class="w-10 h-10 rounded-lg bg-white shadow-sm flex items-center justify-center text-xl text-pink-500 group-hover:scale-110 transition-transform">
                       <i class="ri-window-fill"></i>
                     </div>
                     <span class="font-semibold text-gray-700">Next.js</span>
                  </div>
                  <span class="font-bold text-pink-600">50%</span>
                </div>
                <div class="w-full bg-pink-100 rounded-full h-2.5 overflow-hidden">
                  <div class="progress-bar" style="--target-width: 50%; width: 0%; background: linear-gradient(90deg, #ec4899, #f472b6);"></div>
                </div>
              </div>

              <!-- JavaScript -->
              <div class="group">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-3">
                     <div class="w-10 h-10 rounded-lg bg-white shadow-sm flex items-center justify-center text-xl text-pink-500 group-hover:scale-110 transition-transform">
                       <i class="ri-javascript-fill"></i>
                     </div>
                     <span class="font-semibold text-gray-700">JavaScript</span>
                  </div>
                  <span class="font-bold text-pink-600">75%</span>
                </div>
                <div class="w-full bg-pink-100 rounded-full h-2.5 overflow-hidden">
                  <div class="progress-bar" style="--target-width: 75%; width: 0%; background: linear-gradient(90deg, #ec4899, #f472b6);"></div>
                </div>
              </div>

              <!-- Tailwind CSS -->
              <div class="group">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-3">
                     <div class="w-10 h-10 rounded-lg bg-white shadow-sm flex items-center justify-center text-xl text-pink-500 group-hover:scale-110 transition-transform">
                       <i class="ri-css3-fill"></i>
                     </div>
                     <span class="font-semibold text-gray-700">Tailwind CSS</span>
                  </div>
                  <span class="font-bold text-pink-600">85%</span>
                </div>
                <div class="w-full bg-pink-100 rounded-full h-2.5 overflow-hidden">
                  <div class="progress-bar" style="--target-width: 85%; width: 0%; background: linear-gradient(90deg, #ec4899, #f472b6);"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Backend & Systems Category -->
          <div class="bg-blue-50/50 rounded-3xl p-8 border border-blue-100 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-2xl font-bold text-gray-800 mb-8 flex items-center">
              <i class="ri-server-fill text-blue-500 mr-3"></i> Backend & Systems
            </h3>
            <div class="space-y-6">
              <!-- PHP -->
              <div class="group">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-3">
                     <div class="w-10 h-10 rounded-lg bg-white shadow-sm flex items-center justify-center text-xl text-blue-500 group-hover:scale-110 transition-transform">
                       <i class="ri-braces-fill"></i>
                     </div>
                     <span class="font-semibold text-gray-700">PHP</span>
                  </div>
                  <span class="font-bold text-blue-600">70%</span>
                </div>
                <div class="w-full bg-blue-100 rounded-full h-2.5 overflow-hidden">
                  <div class="progress-bar" style="--target-width: 70%; width: 0%; background: linear-gradient(90deg, #3b82f6, #60a5fa);"></div>
                </div>
              </div>

              <!-- Laravel -->
              <div class="group">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-3">
                     <div class="w-10 h-10 rounded-lg bg-white shadow-sm flex items-center justify-center text-xl text-blue-500 group-hover:scale-110 transition-transform">
                       <i class="ri-fire-fill"></i>
                     </div>
                     <span class="font-semibold text-gray-700">Laravel</span>
                  </div>
                  <span class="font-bold text-blue-600">70%</span>
                </div>
                <div class="w-full bg-blue-100 rounded-full h-2.5 overflow-hidden">
                  <div class="progress-bar" style="--target-width: 70%; width: 0%; background: linear-gradient(90deg, #3b82f6, #60a5fa);"></div>
                </div>
              </div>

              <!-- Databases -->
              <div class="group">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-3">
                     <div class="w-10 h-10 rounded-lg bg-white shadow-sm flex items-center justify-center text-xl text-blue-500 group-hover:scale-110 transition-transform">
                       <i class="ri-database-2-fill"></i>
                     </div>
                     <span class="font-semibold text-gray-700">Databases</span>
                  </div>
                  <span class="font-bold text-blue-600">70%</span>
                </div>
                <div class="w-full bg-blue-100 rounded-full h-2.5 overflow-hidden">
                  <div class="progress-bar" style="--target-width: 70%; width: 0%; background: linear-gradient(90deg, #3b82f6, #60a5fa);"></div>
                </div>
              </div>

              <!-- Git & GitHub -->
              <div class="group">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-3">
                     <div class="w-10 h-10 rounded-lg bg-white shadow-sm flex items-center justify-center text-xl text-blue-500 group-hover:scale-110 transition-transform">
                       <i class="ri-git-branch-line"></i>
                     </div>
                     <span class="font-semibold text-gray-700">Git & GitHub</span>
                  </div>
                  <span class="font-bold text-blue-600">65%</span>
                </div>
                <div class="w-full bg-blue-100 rounded-full h-2.5 overflow-hidden">
                  <div class="progress-bar" style="--target-width: 65%; width: 0%; background: linear-gradient(90deg, #3b82f6, #60a5fa);"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold text-center text-gray-800 mb-4">
          My Projects
        </h2>
        <p class="text-center text-gray-600 mb-2">
          Recent projects I've worked on
        </p>
        <div class="section-title"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Project 1 -->
          <div
            class="project-card card border-2 border-pink-100 hover:border-pink-300 transition-all duration-300"
          >
            <div class="project-image rounded-t-lg overflow-hidden">
              <img
                src="Image/pic1.png"
                alt="Portfolio"
                class="w-full h-full object-cover hover:scale-110 transition duration-700"
              />
            </div>
            <div class="p-6 project-content">
              <div class="mb-4">
                <span
                  class="inline-block bg-pink-100 text-pink-600 text-sm font-semibold px-3 py-1 rounded-full mb-3"
                >
                  Portfolio
                </span>
                <h3 class="font-bold text-gray-800 text-lg mb-2">
                  Personal Portfolio
                </h3>
                <p class="text-gray-600 text-sm mb-4 flex-grow">
                  Modern portfolio website showcasing skills and projects with
                  responsive design and smooth animations.
                </p>
              </div>
              <div class="mt-auto">
                <div class="flex flex-wrap gap-1 mb-4">
                  <span
                    class="text-xs bg-pink-50 text-pink-600 px-2 py-1 rounded"
                    >HTML</span
                  >
                  <span
                    class="text-xs bg-pink-50 text-pink-600 px-2 py-1 rounded"
                    >CSS</span
                  >
                   <span
                    class="text-xs bg-pink-50 text-pink-600 px-2 py-1 rounded"
                    >TailwindCSS</span
                  >
                  <span
                    class="text-xs bg-pink-50 text-pink-600 px-2 py-1 rounded"
                    >JavaScript</span
                  >
                </div>
                <div class="flex gap-3">
                  <button
                    onclick="viewProject('portfolio')"
                    class="flex-1 btn-pink font-medium py-2 px-3 rounded-lg text-center text-sm"
                  >
