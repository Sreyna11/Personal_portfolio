    <!-- Contact Section -->
    <!-- Contact Section -->
    <section id="contact" class="py-20 bg-gradient-to-r from-pink-50 to-white">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold text-center text-gray-800 mb-4">
          Get in Touch
        </h2>
        <p class="text-center text-gray-600 mb-2">
          Let's work together on your next project
        </p>
        <div class="section-title"></div>

        <!-- Contact Form Only -->
        <div class="max-w-2xl mx-auto">
          <div class="card rounded-2xl shadow-lg p-8">
            <h3 class="text-2xl font-bold text-gray-800 mb-8 text-center">
              Send Me a Message
            </h3>
            <p class="text-gray-600 mb-6 text-center">
              Have a project in mind? Let's discuss how we can work together.
            </p>

            <form id="contactForm" class="space-y-6">
              <div>
                <label class="block text-gray-700 mb-2 font-medium"
                  >Your Name</label
                >
                <input
                  type="text"
                  id="name"
                  placeholder="Enter your name"
                  class="w-full p-4 border border-gray-300 rounded-xl focus:outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-200"
                  required
                />
              </div>
              <div>
                <label class="block text-gray-700 mb-2 font-medium"
                  >Your Email</label
                >
                <input
                  type="email"
                  id="email"
                  placeholder="Enter your email"
                  class="w-full p-4 border border-gray-300 rounded-xl focus:outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-200"
                  required
                />
              </div>
              <div>
                <label class="block text-gray-700 mb-2 font-medium"
                  >Your Message</label
                >
                <textarea
                  id="message"
                  placeholder="Tell me about your project..."
                  rows="5"
                  class="w-full p-4 border border-gray-300 rounded-xl focus:outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-200"
                  required
                ></textarea>
              </div>
              <button
                type="submit"
                class="w-full btn-pink font-bold py-4 px-8 rounded-xl text-lg hover:shadow-xl transition-all duration-300"
              >
                Send Message <i class="ri-send-plane-line ml-2"></i>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

